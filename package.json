{
  "name": "pz-vault-launcher",
  "productName": "Project Zomboid Vault",
  "version": "0.8.7",
  "description": "A modern desktop launcher for isolated Project Zomboid environments.",
  "main": "./out/main/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test:share": "node --experimental-strip-types --test src/main/share-package-format.test.ts src/main/share-package-fingerprint.test.ts src/main/share-package-match.test.ts src/main/share-package-roundtrip.test.ts",
    "test:launch": "tsx --test src/main/launch-arguments.test.ts src/main/launch-monitor.test.ts",
    "test:mods": "tsx --test src/main/mod-resolver.test.ts src/main/mod-catalog.test.ts src/main/java-archive-analysis.test.ts",
    "test:mod-center": "tsx --test src/main/mod-center-model.test.ts src/main/mod-loadout-planner.test.ts",
    "test:profiles": "tsx --test src/main/mod-profile-service.test.ts",
    "test:migration": "tsx --test src/main/quick-migration-service.test.ts",
    "test:translation": "tsx --test src/main/translation-analysis.test.ts",
    "test:lua": "tsx --test src/main/lua-analysis.test.ts",
    "test:scripts": "tsx --test src/main/script-analysis.test.ts",
    "test:version-impact": "tsx --test src/main/version-impact-analysis.test.ts",
    "test:radar": "node --experimental-strip-types --test src/renderer/src/radar-layout.test.ts",
    "test:safety": "tsx --test src/main/safe-write.test.ts",
    "test:qa": "pnpm test:safety && pnpm test:share && pnpm test:launch && pnpm test:mods && pnpm test:mod-center && pnpm test:profiles && pnpm test:migration && pnpm test:translation && pnpm test:lua && pnpm test:scripts && pnpm test:version-impact && pnpm test:radar && pnpm typecheck",
    "test:analysis:real": "set NODE_OPTIONS=--import tsx&& electron scripts/analysis-readonly-e2e.ts",
    "test:version-impact:real": "tsx scripts/version-impact-readonly.ts",
    "test:analysis:fixtures": "set NODE_OPTIONS=--import tsx&& electron scripts/analysis-fixture-e2e.ts",
    "test:catalog:real": "tsx scripts/mod-catalog-readonly-e2e.ts",
    "test:mod-center:real": "tsx scripts/mod-center-readonly-e2e.ts",
    "test:profiles:e2e": "set NODE_OPTIONS=--import tsx&& electron scripts/mod-profile-fixture-e2e.ts",
    "test:migration:e2e": "set NODE_OPTIONS=--import tsx&& electron scripts/migration-fixture-e2e.ts",
    "test:migration:interrupt": "tsx scripts/migration-interruption-e2e.ts",
    "test:share:e2e": "set NODE_OPTIONS=--import tsx&& electron scripts/share-package-fixture-e2e.ts",
    "test:import:e2e": "set NODE_OPTIONS=--import tsx&& electron scripts/external-import-fixture-e2e.ts",
    "test:activation:e2e": "set NODE_OPTIONS=--import tsx&& electron scripts/version-activation-fixture-e2e.ts",
    "preview": "electron-vite preview",
    "dist:win": "electron-vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "yazl": "^3.3.1"
  },
  "build": {
    "appId": "com.pzvault.launcher",
    "productName": "Project Zomboid Vault",
    "executableName": "PZVault",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "out/**/*",
      "assets/app-icon.png",
      "package.json"
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "PZ-Vault-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "PZ-Vault-Portable-${version}-${arch}.${ext}"
    }
  }
}
